{
  "expo": {
    "name": "StarSport",
    "slug": "starsport",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-xke.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/01a952fb-4338-49c1-9baf-934af072e720.jpeg",
      "supportsTablet": true,
      "bundleIdentifier": "com.starsport.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSDocumentPickerUsageDescription": "StarSport needs access to your files so you can add your own music tracks for workouts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/01a952fb-4338-49c1-9baf-934af072e720.jpeg",
        "backgroundColor": "#0a0a2e"
      },
      "package": "com.starsport.app",
      "versionCode": 10,
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio",
      "expo-document-picker"
    ],
    "scheme": "starsport",
    "experiments": {
      "typedRoutes": true
    },
    "privacyPolicyUrl": "https://starsport.app/privacy",
    "extra": {
      "router": {}
    }
  }
}